@startuml 01_ms_auth_usuarios
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype polyline
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1F4E79
  ArrowColor #1F4E79
}
skinparam package {
  BorderColor #1F4E79
  BackgroundColor #EEF4FA
}
hide empty members
skinparam nodesep 40
skinparam ranksep 50
title EduSaldo · MS Usuarios y Auth (8081) · db_usuarios\nUsuarios (herencia), relación Apoderado–Alumno, acceso y configuración

legend top right
  Permisos por rol (marca al final de cada método):
  «ADM» Administrador · «ENC» Encargado
  «APO» Apoderado · «ALU» Alumno (≥ 12 años)
  «TODOS» cualquier usuario autenticado · «SIS» sistema
endlegend

package "MS Usuarios y Auth" {

package "Usuarios" {

  enum EstadoCuenta {
    PRIMER_ACCESO
    ACTIVA
    INACTIVA
  }

  enum Parentesco {
    MADRE
    PADRE
    TUTOR_LEGAL
    OTRO
  }

  enum EstadoAsociacion {
    ACTIVA
    DESVINCULADA
  }

  abstract class Usuario {
    - id : Long
    - rut : String
    - primerNombre : String
    - segundoNombre : String [0..1]
    - primerApellido : String
    - segundoApellido : String [0..1]
    - correo : String
    - passwordHash : String [0..1]
    - estado : EstadoCuenta
    - fechaCreacion : LocalDateTime
    --
    + {abstract} getRol() : String
    + getNombreCompleto() : String
    + puedeIniciarSesion() : boolean
    + cambiarPassword(actual : String, nueva : String) : void «TODOS»
    + inactivar() : void «ADM»
    + reactivar() : void «ADM»
    + restablecerPassword() : void «ADM»
  }

  class Administrador {
    --
    + getRol() : String
  }

  class Encargado {
    --
    + getRol() : String
  }

  class Apoderado {
    - telefono : String
    --
    + getRol() : String
    + getAlumnosActivos() : List<Alumno> «APO»
  }

  class Alumno {
    - fechaNacimiento : LocalDate
    - curso : String
    --
    + getRol() : String
    + calcularEdad() : int
    + puedeIniciarSesion() : boolean
    + puedeReservar() : boolean
    + asociarApoderado(apoderado : Apoderado, parentesco : Parentesco) : ApoderadoAlumno «ADM»
    + desvincularApoderado(asociacion : ApoderadoAlumno, motivo : String) : void «ADM»
    + actualizarCurso(curso : String) : void «ADM»
  }

  class ApoderadoAlumno {
    - parentesco : Parentesco
    - estado : EstadoAsociacion
    - fechaAsociacion : LocalDateTime
    - fechaDesvinculacion : LocalDateTime [0..1]
    - motivoDesvinculacion : String [0..1]
    --
    + desvincular(motivo : String) : void «ADM»
  }

}

package "Acceso y seguridad" {

  class PoliticaAcceso {
    - maxIntentosFallidos : int
    - minutosBloqueo : int
    - minutosVigenciaSesion : int
    --
    + debeBloquear(intentosRecientes : int) : boolean «SIS»
    + modificar(...) : void «ADM»
  }

  class IntentoAcceso {
    - correo : String
    - fecha : LocalDateTime
    - exitoso : boolean
  }

  class ConsentimientoPrivacidad {
    - versionAviso : String
    - fechaAceptacion : LocalDateTime
    --
    + aceptar(version : String) : void «APO» «ALU»
  }

  class TokenRecuperacion {
    - token : String
    - fechaExpiracion : LocalDateTime
    - usado : boolean
    --
    + estaVigente() : boolean
  }

}

package "Configuración y auditoría" {

  class ConfiguracionInstitucional {
    - nombreEstablecimiento : String
    - nombreLibreria : String
    - correoContacto : String
    - logoUrl : String
    --
    + actualizar(...) : void «ADM»
  }

  class ParametroSistema {
    - clave : String
    - valor : String
    --
    + modificar(valor : String) : void «ADM»
  }

  class RegistroAuditoria {
    - fechaHora : LocalDateTime
    - usuarioId : Long
    - accion : String
    - entidad : String
    - entidadId : String
    - detalle : String
  }

  class ConsultaContacto {
    - primerNombre : String
    - primerApellido : String
    - correo : String
    - mensaje : String
    - fecha : LocalDateTime
  }

}

}

' Herencia
Usuario <|-- Administrador
Usuario <|-- Encargado
Usuario <|-- Apoderado
Usuario <|-- Alumno

' Relación N:M modelada formalmente con clase de asociación UML
Apoderado "1..*" -- "0..*" Alumno : asociados >
(Apoderado, Alumno) .. ApoderadoAlumno

' Composiciones y dependencias
Usuario "1" *-- "0..*" TokenRecuperacion
Usuario "1" *-- "0..*" ConsentimientoPrivacidad : acepta >
PoliticaAcceso ..> IntentoAcceso : evalúa
RegistroAuditoria ..> Usuario : audita >

note right of Alumno
  Alumno ≥ 12 años: inicia sesión con correo
  institucional, consulta saldo y puede reservar.
  Alumno < 12: no inicia sesión; se identifica
  en mesón y reserva su apoderado.
end note

note bottom of ApoderadoAlumno
  Clase de asociación Apoderado–Alumno:
  un alumno tiene 1..* apoderados y un apoderado
  tiene 0..* alumnos.
  Alta atómica en HU15: no existe apoderado sin
  alumno ni alumno sin apoderado.
  No se borra: se desvincula con fecha y motivo.
end note

note bottom of Encargado
  Administrador y Encargado usan correo institucional.
  Apoderado usa correo personal.
  Ya no existe el rol Autorizador:
  el Administrador aprueba.
end note

note bottom of PoliticaAcceso
  El bloqueo por intentos fallidos no es un estado
  de Usuario: lo evalúa dinámicamente PoliticaAcceso
  al autenticar usando los IntentoAcceso recientes.
end note

' Herencia
Usuario <|-- Administrador
Usuario <|-- Encargado
Usuario <|-- Apoderado
Usuario <|-- Alumno

' Conexión de Enums con sus Clases
Usuario ..> EstadoCuenta : estado
ApoderadoAlumno ..> Parentesco : parentesco
ApoderadoAlumno ..> EstadoAsociacion : estado
@enduml